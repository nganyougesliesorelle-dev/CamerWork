# CamerWork Backend — Environment Variables
# Copy to .env and fill in values

# Server
PORT=3001
NODE_ENV=development

# Firebase Admin SDK (service account JSON path)
FIREBASE_SERVICE_ACCOUNT=./service-account.json
FIREBASE_STORAGE_BUCKET=camerwork-1e3d0.firebasestorage.app
FIREBASE_API_KEY=

# JWT
JWT_SECRET=change-me-to-a-256-bit-random-string
JWT_EXPIRES_IN=1h

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10

# Encryption (AES-256)
ENCRYPTION_SECRET=change-me-to-a-64-char-hex-string

# HTTPS (production)
# En production, le middleware httpsEnforcer redirige HTTP → HTTPS
# Pour désactiver la redirection (ex: tests), laisser NODE_ENV=development
HTTPS_REDIRECT=true

# ClamAV (optional)
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# Sentry (optional — npm install @sentry/node)
# Laissez vide pour désactiver (mode développement)
SENTRY_DSN=
