# CamerWork Backend — Variables d'environnement
# 
# ⚠️  NE JAMAIS COMMITER le fichier .env réel !
# ⚠️  Ce fichier .env.example est un TEMPLATE de référence.
#
# Générer des secrets forts :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

# ─── Serveur ───────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Firebase Admin SDK ────────────────────────────────────────
# Chemin vers le fichier JSON de compte de service Firebase
# Télécharger depuis : Console Firebase → Paramètres → Comptes de service
FIREBASE_SERVICE_ACCOUNT=./service-account.json
FIREBASE_STORAGE_BUCKET=camerwork-1e3d0.firebasestorage.app
# API Key pour l'API REST Firebase Identity Toolkit (backend uniquement)
FIREBASE_API_KEY=

# ─── JWT (JSON Web Token) ──────────────────────────────────────
# ⚠️  OBLIGATOIRE en production — générer avec :
#     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h
# Refresh token (optionnel, pour rotation de token)
JWT_REFRESH_EXPIRES_IN=7d

# ─── Rate Limiting ─────────────────────────────────────────────
# Fenêtre glissante en millisecondes (défaut: 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
# Nombre max de requêtes par IP dans la fenêtre
RATE_LIMIT_MAX_REQUESTS=100
# Limiteur strict pour l'authentification (tentatives/login)
AUTH_RATE_LIMIT_MAX=10
# Limiteur pour le reset de mot de passe
PASSWORD_RESET_RATE_LIMIT_MAX=3
PASSWORD_RESET_WINDOW_MS=3600000

# ─── Chiffrement AES-256 ───────────────────────────────────────
# ⚠️  OBLIGATOIRE en production — 64 caractères hexadécimaux :
#     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_SECRET=

# ─── Account Lockout (force brute) ─────────────────────────────
# Nombre de tentatives avant verrouillage temporaire
BRUTE_FORCE_THRESHOLD=5
# Fenêtre de détection en millisecondes (défaut: 15 minutes)
BRUTE_FORCE_WINDOW_MS=900000
# Durée du verrouillage en millisecondes (défaut: 30 minutes)
BRUTE_FORCE_LOCKOUT_MS=1800000

# ─── HTTPS / TLS ───────────────────────────────────────────────
# En production, le middleware httpsEnforcer redirige HTTP → HTTPS
# Désactiver uniquement en développement local
HTTPS_REDIRECT=true

# ─── ClamAV (antivirus — optionnel en dev, obligatoire en prod) ─
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=30000

# ─── CSRF Protection ───────────────────────────────────────────
# Secret pour signer les tokens CSRF (cookie double-submit)
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CSRF_SECRET=

# ─── Sentry (surveillance — optionnel) ─────────────────────────
# Laissez vide pour désactiver (mode développement)
# npm install @sentry/node pour activer
SENTRY_DSN=

# ─── SMTP (Emails transactionnels) ──────────────────────────────
# Fournisseur SMTP : SendGrid, Mailgun, Brevo, AWS SES, Gmail...
# Exemple Gmail : smtp.gmail.com / 587
# Exemple SendGrid : smtp.sendgrid.net / 587
# Laissez vide pour désactiver l'envoi réel d'emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Adresse d'expédition (format : "Nom" <email>)
SMTP_FROM="CamerWork" <noreply@camerwork.app>

# ─── CORS ──────────────────────────────────────────────────────
# Origines autorisées (séparées par des virgules)
# En production, lister UNIQUEMENT les domaines de confiance
CORS_ORIGINS=https://camerwork-1e3d0.web.app,https://camerwork-1e3d0.firebaseapp.com
