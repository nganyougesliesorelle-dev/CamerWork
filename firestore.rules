rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // FONCTIONS HELPERS
    // ============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isRecruiter() {
      return getUserRole() == 'recruiter' || getUserRole() == 'recruteur';
    }

    function isCandidate() {
      return getUserRole() == 'candidate' || getUserRole() == 'candidat' || getUserRole() == 'student';
    }

    function isVerifiedRecruiter() {
      let user = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return isRecruiter() && user.kycStatus == 'verified';
    }

    function isAdmin() {
      return getUserRole() == 'admin';
    }

    function isValidRole(role) {
      return role in ['candidate', 'candidat', 'student', 'recruiter', 'recruteur', 'admin'];
    }

    function isNonEmptyString(value) {
      return value is string && value.size() > 0;
    }

    function isValidServerTimestamp(ts) {
      // serverTimestamp() est résolu à request.time par le serveur.
      // NE PAS utiliser "ts is timestamp" — la sentinelle n'est pas de type timestamp.
      return ts == request.time;
    }

    // ── Chat : l'utilisateur est-il l'un des 2 UIDs dans le chatId ? ──
    // chatId = uid1_uid2 (triés).  Aucun get() nécessaire.
    function isChatParticipant(chatId) {
      return chatId.split('_').hasAny([request.auth.uid]);
    }

    // ============================================================
    // COLLECTION : users
    // ============================================================
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isOwner(userId)
                    && isValidRole(request.resource.data.role)
                    && isValidServerTimestamp(request.resource.data.createdAt);
      allow update: if isAuthenticated() && (
                      isOwner(userId) && !(request.resource.data.diff(resource.data).affectedKeys()
                           .hasAny(['role', 'kycStatus', 'createdAt']))
                      || isAdmin() && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['isValidated', 'kycStatus', 'validationSteps', 'validatedAt', 'validatedBy', 'validatedCompany'])
                    );
      allow delete: if isAuthenticated() && isAdmin();
    }

    // ============================================================
    // COLLECTION : jobs
    // ============================================================
    match /jobs/{jobId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
                    && request.resource.data.recruiterId == request.auth.uid
                    && isNonEmptyString(request.resource.data.title)
                    && isNonEmptyString(request.resource.data.company)
                    && isValidServerTimestamp(request.resource.data.createdAt)
                    && (
                         (request.resource.data.status == 'open' && isVerifiedRecruiter())
                         || (request.resource.data.status == 'pending_moderation' && isRecruiter())
                       );
      allow update: if isAuthenticated()
                    && resource.data.recruiterId == request.auth.uid
                    && !(request.resource.data.diff(resource.data).affectedKeys()
                         .hasAny(['recruiterId', 'createdAt']));
      allow delete: if isAuthenticated()
                    && (resource.data.recruiterId == request.auth.uid || isAdmin());
    }

    // ============================================================
    // COLLECTION : applications
    // ============================================================
    match /applications/{appId} {
      allow read: if isAuthenticated()
                  && (resource.data.candidateId == request.auth.uid
                      || resource.data.recruiterId == request.auth.uid);
      allow create: if isAuthenticated() && isCandidate()
                    && request.resource.data.candidateId == request.auth.uid
                    && isNonEmptyString(request.resource.data.jobId)
                    && isValidServerTimestamp(request.resource.data.appliedAt);
      allow update: if isAuthenticated()
                    && resource.data.recruiterId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['status'])
                    && request.resource.data.status in ['accepted', 'retenu', 'rejected', 'refusé'];
      allow delete: if isAuthenticated()
                    && resource.data.candidateId == request.auth.uid;
    }

    // ============================================================
    // COLLECTION : messages  (CHAT INSTANTANÉ)
    // ============================================================
    // chatId = uid1_uid2 où uid1 < uid2 (triés alphabétiquement).
    // Aucune dépendance sur une collection "chats" — le chatId suffit.
    match /messages/{msgId} {
      allow read: if isAuthenticated()
                  && isChatParticipant(resource.data.chatId);

      allow create: if isAuthenticated()
                    && request.resource.data.senderId == request.auth.uid
                    && isChatParticipant(request.resource.data.chatId)
                    && isNonEmptyString(request.resource.data.chatId)
                    && isValidServerTimestamp(request.resource.data.timestamp);

      // Mise à jour : uniquement status + acceptedSlot (acceptation d'entretien)
      allow update: if isAuthenticated()
                    && isChatParticipant(resource.data.chatId)
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['status', 'acceptedSlot']);

      allow delete: if false;
    }

    // ============================================================
    // COLLECTION : notifications
    // ============================================================
    match /notifications/{notifId} {
      allow read: if isAuthenticated()
                  && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated()
                    && isValidServerTimestamp(request.resource.data.createdAt);
      allow update: if isAuthenticated()
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['read']);
      allow delete: if isAuthenticated()
                    && resource.data.userId == request.auth.uid;
    }

    // ============================================================
    // COLLECTION : relations
    // ============================================================
    match /relations/{relId} {
      allow read: if isAuthenticated()
                  && (resource.data.requesterId == request.auth.uid
                      || resource.data.targetId == request.auth.uid);
      allow create: if isAuthenticated()
                    && request.resource.data.requesterId == request.auth.uid
                    && isValidServerTimestamp(request.resource.data.createdAt);
      allow update: if isAuthenticated()
                    && resource.data.targetId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['status']);
      allow delete: if isAuthenticated()
                    && (resource.data.requesterId == request.auth.uid
                        || resource.data.targetId == request.auth.uid);
    }

    // ============================================================
    // COLLECTION : reports
    // ============================================================
    match /reports/{reportId} {
      allow read: if isAuthenticated()
                  && (resource.data.reporterId == request.auth.uid || isAdmin());
      // Emergency temporary: allow any authenticated client to create reports.
      allow create: if true;
      allow update: if isAuthenticated() && isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['status'])
                    && request.resource.data.status in ['pending', 'under_review', 'resolved'];
      allow delete: if isAuthenticated() && isAdmin();
    }

    // ============================================================
    // COLLECTION : favorites
    // ============================================================
    match /favorites/{favId} {
      allow read: if isAuthenticated()
                  && resource.data.userId == request.auth.uid;
      // Emergency temporary: allow any client to create favorites to unblock users.
      // NOTE: This is intentionally permissive and must be tightened ASAP.
      allow create: if true;
      allow delete: if isAuthenticated()
                    && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    // ============================================================
    // COLLECTION : conversations
    // ============================================================
    match /conversations/{convId} {
      allow read: if isAuthenticated()
                  && request.auth.uid in resource.data.participants;
      allow create: if isAuthenticated()
                    && request.auth.uid in request.resource.data.participants
                    && request.resource.data.participants.size() == 2;
      allow update: if isAuthenticated()
                    && request.auth.uid in resource.data.participants
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['lastMessage', 'lastSenderId', 'lastSenderName', 'updatedAt', 'unreadCount']);
      allow delete: if false; // Pas de suppression par les utilisateurs
    }

    // ============================================================
    // COLLECTION : presence
    // ============================================================
    match /presence/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isOwner(userId);
      allow delete: if false;
    }

    // ============================================================
    // RÈGLE PAR DÉFAUT
    // ============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
